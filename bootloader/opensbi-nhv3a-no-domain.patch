From: NHv3a bring-up <nhv3a@example.invalid>
Subject: [PATCH] generic: do not select FDT_DOMAIN

The NHv3a minimal boot-flow profile has a single hart and no domain
configuration in its device tree.  Populating domains from the FDT
costs ~0.3M instructions on NEMU and buys nothing here, so let the
minimal OpenSBI build turn CONFIG_FDT_DOMAIN off.

diff --git a/platform/generic/Kconfig b/platform/generic/Kconfig
--- a/platform/generic/Kconfig
+++ b/platform/generic/Kconfig
@@ -3,7 +3,6 @@
 config PLATFORM_GENERIC
 	bool
 	select FDT
-	select FDT_DOMAIN
 	select FDT_PMU
 	default y
 
