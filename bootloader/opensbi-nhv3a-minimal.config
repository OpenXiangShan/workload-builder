# NHv3a minimal OpenSBI configuration (generic platform).
#
# Compared with bootloader/opensbi.config this keeps only what a single-hart
# Linux/hello boot needs:
#   - TIME / RFENCE / IPI / HSM SBI extensions (the defaults)
#   - FDT, PLIC irqchip, mtime timer, 8250 console
# and drops the optional SBI extensions (SRST, SUSP, PMU, DBCN, CPPC, FWFT,
# LEGACY, VENDOR, DBTR, SSE, MPXY) and every FDT driver the NHv3a SoC does not
# have (APLIC/IMSIC, PLMT, GPIO, I2C, HSM device, mailbox, regmap, reset,
# suspend, MPXY, uartlite, cadence, ...).
#
# Built with FW_OPTIONS=1 so the OpenSBI banner/platform dump is not printed.
# CONFIG_SBI_ECALL_LEGACY is intentionally off: Linux uses only the v0.2+
# extensions, and OpenSBI's legacy console must not be required.
# CONFIG_SBI_ECALL_HSM is left at its default (y) because Linux probes it.

# CONFIG_SBI_ECALL_SRST is not set
# CONFIG_SBI_ECALL_SUSP is not set
# CONFIG_SBI_ECALL_PMU is not set
# CONFIG_SBI_ECALL_DBCN is not set
# CONFIG_SBI_ECALL_CPPC is not set
# CONFIG_SBI_ECALL_FWFT is not set
# CONFIG_SBI_ECALL_LEGACY is not set
# CONFIG_SBI_ECALL_VENDOR is not set
# CONFIG_SBI_ECALL_DBTR is not set
# CONFIG_SBI_ECALL_SSE is not set
# CONFIG_SBI_ECALL_MPXY is not set

CONFIG_FDT_IPI=y
CONFIG_FDT_IPI_PLICSW=y
CONFIG_FDT_IRQCHIP=y
CONFIG_FDT_IRQCHIP_PLIC=y
CONFIG_FDT_SERIAL=y
CONFIG_FDT_SERIAL_UART8250=y
CONFIG_FDT_TIMER=y
CONFIG_FDT_TIMER_MTIMER=y
