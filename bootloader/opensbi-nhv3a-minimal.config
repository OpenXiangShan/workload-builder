# NHv3a minimal OpenSBI configuration (generic platform, single hart).
#
# Keeps exactly what the hello boot-flow test uses:
#   - RFENCE SBI extension (TLB/fence calls); TIME is dropped because the
#     KHMV2 device tree advertises sstc, so Linux uses stimecmp directly
#   - FDT so the DT is handed to the kernel
# No console driver: the kernel uses its own 8250 + earlycon, and OpenSBI
# prints nothing (FW_OPTIONS=1), so the SBI console would never be used.
#
# Drops everything a single-hart, no-external-IRQ test does not need:
#   - SRST/SUSP/PMU/DBCN/CPPC/FWFT/LEGACY/VENDOR/DBTR/SSE/MPXY
#   - IPI and HSM (no secondary hart)
#   - PLIC irqchip init (the Linux PLIC driver initialises the PLIC itself)
#   - every FDT driver the NHv3a SoC does not have (APLIC/IMSIC, PLMT, GPIO,
#     I2C, mailbox, regmap, reset, suspend, MPXY, uartlite, cadence, ...)
#
# Built with FW_OPTIONS=1 so the OpenSBI banner/platform dump is not printed.

# CONFIG_SBI_ECALL_SRST is not set
# CONFIG_SBI_ECALL_SUSP is not set
# CONFIG_SBI_ECALL_PMU is not set
# CONFIG_SBI_ECALL_DBCN is not set
# CONFIG_SBI_ECALL_CPPC is not set
# CONFIG_SBI_ECALL_FWFT is not set
# CONFIG_SBI_ECALL_LEGACY is not set
# CONFIG_SBI_ECALL_VENDOR is not set
# CONFIG_SBI_ECALL_DBTR is not set
# CONFIG_SBI_ECALL_SSE is not set
# CONFIG_SBI_ECALL_MPXY is not set
# CONFIG_SBI_ECALL_IPI is not set
# CONFIG_SBI_ECALL_HSM is not set

# CONFIG_FDT_IPI is not set
# CONFIG_FDT_IPI_PLICSW is not set
# CONFIG_FDT_IRQCHIP is not set
# CONFIG_FDT_IRQCHIP_PLIC is not set

# CONFIG_FDT_SERIAL is not set
# CONFIG_SERIAL_UART8250 is not set
# CONFIG_SBI_ECALL_TIME is not set
# CONFIG_FDT_TIMER is not set
# CONFIG_FDT_TIMER_MTIMER is not set
# The packed DTB handed to the kernel does not need to be expandable in
# place: skipping the 4 KiB fdt_open_into() expansion saves ~80K instructions.
CONFIG_PLATFORM_GENERIC_FDT_EMPTY_SPACE=0
