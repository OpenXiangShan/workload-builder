/*
 * KMHV2 (Kunminghu V2) minimal boot-flow test profile.
 *
 * The KMHV2 platform's own address map (UART0 at 0x310b0000, PLIC at
 * 0x3c000000, CLINT at 0x38000000, 2 GiB of DRAM at 0x80000000) with the
 * same boot-flow trimming as nhv3a-minimal.dts.in:
 *
 *   - the kernel gets its timer from stimecmp (sstc), so the CLINT node is
 *     only kept (disabled) for the build scripts, which read its address;
 *   - no reserved-memory node: OpenSBI's fixup recreates it with the
 *     mmode_resv entries for the firmware, and the GCPT area can be reused;
 *   - sv39 instead of sv48 (the 2 GiB window fits easily);
 *   - the legacy riscv,isa string with the full KMHV2 extension set plus
 *     sstc, which is much cheaper for the kernel to parse than the
 *     riscv,isa-extensions list.
 */

/dts-v1/;

/ {
    #address-cells = <2>;
    #size-cells = <2>;

    chosen {
        bootargs = "console=ttyS0 riscv_isa_fallback";
        /* ASCII: "KMHV2_HELLO_RANDOM_SEED" */
        rng-seed = /bits/ 8 <0x4b 0x4d 0x48 0x56 0x32 0x5f 0x48 0x45 0x4c 0x4c 0x4f 0x5f 0x52 0x41 0x4e 0x44 0x4f 0x4d 0x5f 0x53 0x45 0x45 0x44>;
        linux,initrd-start = <INITRAMFS_BEGIN_HI INITRAMFS_BEGIN_LO>;
        linux,initrd-end = <INITRAMFS_END_HI INITRAMFS_END_LO>;
    };

    memory@80000000 {
        device_type = "memory";
        reg = <0x0 0x80000000 0x0 0x80000000>;
    };

    cpus {
        #address-cells = <1>;
        #size-cells = <0>;
        timebase-frequency = <1000000>;

        cpu0: cpu@0 {
            compatible = "ICT,xiangshan", "riscv";
            device_type = "cpu";
            mmu-type = "riscv,sv39";
            reg = <0>;
            riscv,isa = "rv64imafdch_sdtrig_sha_shcounterenw_shgatpa_shlcofideleg_shtvala_shvsatpa_shvstvala_shvstvecd_smcsrind_smdbltrp_smmpm_smnpm_smstateen_ss1p13_sspm_ssccptr_sscofpmf_sscounterenw_sscsrind_ssdbltrp_ssnpm_ssstateen_ssstrict_sstvala_sstvecd_ssu64xl_supm_sv39_sv48_svpbmt_svade_svbare_svinval_svnapot_za64rs_zacas_zawrs_zba_zbb_zbc_zbkb_zbkc_zbkx_zbs_zca_zcb_zcmop_zfa_zfh_zfhmin_zic64b_ziccamoa_ziccif_zicclsm_ziccrse_zicntr_zicond_zicsr_zifencei_zihpm_zihintpause_zihintntl_zimop_zkn_zknd_zkne_zknh_zksed_zksh_zkt_sstc";

            cpu0_intc: interrupt-controller {
                #interrupt-cells = <1>;
                compatible = "riscv,cpu-intc";
                interrupt-controller;
            };
        };
    };

    /* Kept only for the build scripts (CLINT address); Linux uses sstc. */
    clint: clint@38000000 {
        compatible = "riscv,clint0";
        reg = <0x0 0x38000000 0x0 0x10000>;
        status = "disabled";
    };

    plic: plic@3c000000 {
        compatible = "riscv,plic0";
        reg = <0x0 0x3c000000 0x0 0x4000000>;
        #interrupt-cells = <1>;
        interrupt-controller;
        interrupts-extended = <&cpu0_intc 11>, <&cpu0_intc 9>;
        riscv,max-priority = <7>;
        riscv,ndev = <66>;
    };

    uart0: serial@310b0000 {
        compatible = "ns16550a";
        reg = <0x0 0x310b0000 0x0 0x10000>;
        reg-shift = <2>;
        reg-io-width = <4>;
        clock-frequency = <50000000>;
    };
};
