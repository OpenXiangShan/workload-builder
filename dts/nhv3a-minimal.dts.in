/*
 * NHv3a minimal boot-flow test profile.
 *
 * Same CPU/CLINT/UART0 address map as nhv3a.dts.in, but reduced to what the
 * Linux/hello smoke test actually uses.  Every node and property here costs
 * instructions: OpenSBI and Linux both walk the flattened tree several times
 * at boot (libfdt lookups are O(tree size)), so this file is kept as small as
 * the kernel accepts:
 *
 *   - 8 MiB of DRAM instead of the full 32 GiB window (the kernel memmap for
 *     32 GiB alone costs ~750M instructions on NEMU)
 *   - no PLIC node: the test has no external interrupts, and probing the
 *     64 MiB PLIC window costs ~0.4M instructions in the Linux PLIC driver
 *   - a single UART, directly under the root node (no simple-bus wrapper)
 *   - no model/compatible/stdout-path/aliases/cache properties
 *   - only the ISA extensions this CPU actually advertises
 *
 * For a real boot use nhv3a.dts.in, which describes the whole SoC.
 */

/dts-v1/;

/ {
    #address-cells = <2>;
    #size-cells = <2>;

    chosen {
        bootargs = "console=ttyS0";
        /* ASCII: "NHV3A_SOC_BOARD_RANDOM_SEED" */
        rng-seed = /bits/ 8 <0x4e 0x48 0x56 0x33 0x41 0x5f 0x53 0x4f 0x43 0x5f 0x42 0x4f 0x41 0x52 0x44 0x5f 0x52 0x41 0x4e 0x44 0x4f 0x4d 0x5f 0x53 0x45 0x45 0x44>;
        linux,initrd-start = <INITRAMFS_BEGIN_HI INITRAMFS_BEGIN_LO>;
        linux,initrd-end = <INITRAMFS_END_HI INITRAMFS_END_LO>;
    };

    memory@80000000 {
        device_type = "memory";
        reg = <0x0 0x80000000 0x0 0x800000>;
    };

    cpus {
        #address-cells = <1>;
        #size-cells = <0>;
        timebase-frequency = <1000000>;

        cpu0: cpu@0 {
            compatible = "ICT,xiangshan", "riscv";
            device_type = "cpu";
            mmu-type = "riscv,sv39";
            reg = <0>;
            riscv,isa-base = "rv64i";
            riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "h", "sdtrig", "sha", "shcounterenw", "shgatpa", "shlcofideleg", "shtvala", "shvsatpa", "shvstvala", "shvstvecd", "smcsrind", "smdbltrp", "smmpm", "smnpm", "smstateen", "ss1p13", "sspm", "ssccptr", "sscofpmf", "sscounterenw", "sscsrind", "ssdbltrp", "ssnpm", "ssstateen", "ssstrict", "sstvala", "sstvecd", "ssu64xl", "supm", "sv39", "sv48", "svpbmt", "svade", "svbare", "svinval", "svnapot", "za64rs", "zacas", "zawrs", "zba", "zbb", "zbc", "zbkb", "zbkc", "zbkx", "zbs", "zca", "zcb", "zcmop", "zfa", "zfh", "zfhmin", "zic64b", "ziccamoa", "ziccif", "zicclsm", "ziccrse", "zicntr", "zicond", "zicsr", "zifencei", "zihpm", "zihintpause", "zihintntl", "zimop", "zkn", "zknd", "zkne", "zknh", "zksed", "zksh", "zkt", "sstc";

            cpu0_intc: interrupt-controller {
                #address-cells = <0>;
                #interrupt-cells = <1>;
                compatible = "riscv,cpu-intc";
                interrupt-controller;
            };
        };
    };

    /*
     * Disabled CLINT: the kernel gets its timer from stimecmp (sstc) and
     * OpenSBI's SBI TIME extension is disabled, so neither side needs
     * the machine timer.  The node stays only because the build scripts
     * derive the CLINT address from it; "disabled" keeps the kernel from
     * creating a platform device that never probes.
     */
    clint@38000000 {
        compatible = "riscv,clint0";
        reg = <0x0 0x38000000 0x0 0x10000>;
        status = "disabled";
    };

    /* The image keeps GCPT + OpenSBI at the start of DRAM. */
    reserved-memory {
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;
        gcpt@80000000 {
            reg = <0x0 0x80000000 0x0 0x100000>;
            no-map;
        };
    };

    uart0: serial@50000 {
        compatible = "ns16550a";
        reg = <0x0 0x50000 0x0 0x10000>;
        reg-shift = <2>;
        reg-io-width = <4>;
        clock-frequency = <83333333>;
    };
};
