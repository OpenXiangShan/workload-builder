# NHv3a minimal Linux configuration fragment (Linux/hello smoke test).
#
# Applied on top of br2-external/board/openxiangshan/nemu/linux.config by
# br2-external/configs/nhv3a_minimal_defconfig.  Goal: the smallest Linux
# boot that can exec a static /init and print one line on the DesignWare
# UART, with no network/PCI/USB/storage/display and a quiet console.
#
# The initramfs is NOT built into the kernel here: the workload cpio is
# passed through the device tree (linux,initrd-start/end) and unpacked by
# CONFIG_BLK_DEV_INITRD, which saves both kernel size and unpack work.

# --- memory profile ---------------------------------------------
# The SoC DTS keeps the full 32 GiB DDR window, but the hello boot-flow
# test only needs the low 1 GiB.  Limiting mem= cuts the kernel's
# memmap/buddy initialisation from ~750M instructions to ~24M; the DTS
# stays a faithful description of the SoC.
# --- single hart, no virtualization -----------------------------
# CONFIG_SMP is not set
CONFIG_NR_CPUS=1
# CONFIG_HOTPLUG_CPU is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_KVM is not set
# CONFIG_RISCV_BOOT_SPINWAIT is not set
# CONFIG_SUSPEND is not set

# --- no networking ----------------------------------------------
# CONFIG_NET is not set
# CONFIG_INET is not set
# CONFIG_PACKET is not set
# CONFIG_UNIX is not set
# CONFIG_BPF_SYSCALL is not set

# --- no PCI / USB / storage / display ---------------------------
# CONFIG_PCI is not set
# CONFIG_BLOCK is not set
# CONFIG_VIRTIO_MENU is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MMC is not set
# CONFIG_MTD is not set
# CONFIG_SPI is not set
# CONFIG_I2C is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_INPUT is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_FB is not set
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
# CONFIG_HWMON is not set
# CONFIG_IOMMU_SUPPORT is not set

# --- minimal filesystem surface ---------------------------------
# CONFIG_EXT4_FS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_TMPFS is not set
# CONFIG_HUGETLBFS is not set
# CONFIG_CONFIGFS_FS is not set
# CONFIG_MISC_FILESYSTEMS is not set
# CONFIG_PROC_FS is not set
# CONFIG_SYSFS is not set
# CONFIG_DEVTMPFS is not set
# CONFIG_DEVTMPFS_MOUNT is not set
# CONFIG_NLS is not set

# --- trim core features -----------------------------------------
# CONFIG_SYSVIPC is not set
# CONFIG_CGROUPS is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_RPMSG is not set
# CONFIG_XZ_DEC is not set
# CONFIG_RISCV_ISA_V is not set
# CONFIG_RISCV_SBI_V01 is not set
# CONFIG_SERIAL_UARTLITE is not set
# CONFIG_SERIAL_SIFIVE is not set
# CONFIG_HW_RANDOM is not set
# CONFIG_EEPROM_93CX6 is not set
# CONFIG_SERIO_LIBPS2 is not set
# CONFIG_SYNC_FILE is not set
# CONFIG_RUNTIME_TESTING_MENU is not set

# --- quiet boot --------------------------------------------------
CONFIG_CMDLINE="quiet loglevel=0 mem=1G"
CONFIG_CMDLINE_EXTEND=y

# --- initramfs comes from the DT, not from the kernel image ------
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
