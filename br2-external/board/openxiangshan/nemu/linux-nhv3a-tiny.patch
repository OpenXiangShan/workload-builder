From: NHv3a bring-up <nhv3a@example.invalid>
Subject: [PATCH] riscv: do not select PLIC/APLIC/IMSIC/COMMON_CLK

The NHv3a minimal boot-flow profile has no external interrupts and no
clock tree, and each of these drivers costs an initcall plus a DT probe
on a machine that only needs the SBI timer and the 8250 console.

Dropping the selects lets the tiny config turn CONFIG_SIFIVE_PLIC,
CONFIG_RISCV_APLIC, CONFIG_RISCV_IMSIC and CONFIG_COMMON_CLK off
instead of having them forced on by ARCH_RISCV.  ~70K instructions on
the linux-hello test.

diff --git a/arch/riscv/Kconfig b/arch/riscv/Kconfig
--- a/arch/riscv/Kconfig
+++ b/arch/riscv/Kconfig
@@ -94,7 +94,6 @@
 	select BUILDTIME_TABLE_SORT if MMU
 	select CLINT_TIMER if RISCV_M_MODE
 	select CLONE_BACKWARDS
-	select COMMON_CLK
 	select CPU_NO_EFFICIENT_FFS if !RISCV_ISA_ZBB
 	select CPU_PM if CPU_IDLE || HIBERNATION || SUSPEND
 	select DYNAMIC_FTRACE if FUNCTION_TRACER
@@ -215,11 +214,8 @@
 	select PCI_MSI if PCI
 	select RELOCATABLE if !MMU && !PHYS_RAM_BASE_FIXED
 	select RISCV_ALTERNATIVE
-	select RISCV_APLIC
-	select RISCV_IMSIC
 	select RISCV_INTC
 	select RISCV_TIMER if RISCV_SBI
-	select SIFIVE_PLIC
 	select SPARSE_IRQ
 	select SYSCTL_EXCEPTION_TRACE
 	select THREAD_INFO_IN_TASK
